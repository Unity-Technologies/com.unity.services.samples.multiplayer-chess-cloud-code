{
  "$schema": "https://ugs-config-schemas.unity3d.com/v1/matchmaker/matchmaker-queue.schema.json",
  "name": "default-queue",
  "enabled": true,
  "maxPlayersPerTicket": 2,
  "defaultPool": {
    "variants": [],
    "name": "default-pool",
    "enabled": true,
    "timeoutSeconds": 90,
    "matchLogic": {
      "matchDefinition": {
        "teams": [
          {
            "name": "Team",
            "teamCount": {
              "min": 2,
              "max": 2,
              "relaxations": []
            },
            "playerCount": {
              "min": 2,
              "max": 2,
              "relaxations": []
            },
            "teamRules": []
          }
        ],
        "matchRules": [
          {
            "name": "elo-rating",
            "source": "Players.CustomData.ExternalData.Leaderboard.Score",
            "ExternalData": {
                "Leaderboard": {
                    "Id": "EloRatings"
                }
            },
            "type": "Difference",
            "reference": 500,
            "overlap": 0.0,
            "enableRule": true,
            "not": false,
            "relaxations": []
          }
        ]
      },
      "name": "Default Pool Rules",
      "backfillEnabled": false
    },
    "matchHosting": {
      "type": "MatchId"
    }
  },
  "filteredPools": []
}